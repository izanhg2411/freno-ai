{
  "manifest_version": 3,
  "name": "FRENO",
  "version": "0.1.0",
  "description": "Usa la IA para aprender, no para dejar de pensar. Un tutor que te pide tu intento antes de dar pistas.",
  "minimum_chrome_version": "114",
  "action": { "default_title": "Abrir FRENO" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "sidePanel", "contextMenus"],
  "host_permissions": ["https://api.anthropic.com/*", "https://api.openai.com/*", "https://generativelanguage.googleapis.com/*"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
