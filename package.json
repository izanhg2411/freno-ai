{
  "name": "freno",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FRENO: tutor con IA que te hace pensar antes de darte la respuesta (extensión de Chrome, Manifest V3).",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "icons": "node scripts/icons.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run e2e",
    "e2e": "node tests/e2e.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.300",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0",
    "sharp": "^0.34.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
